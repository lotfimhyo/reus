# Founder: Lotfi Mahiddine | Organization: Reulink
# Copy to /etc/reus/<node-name>.env and chmod 600. Do not commit it.
REUS_NODE_ROLE=text-node
REUS_NODE_LABEL=first
REUS_MTLS_HOST=127.0.0.1
REUS_MTLS_PORT=9443
REUS_BOOTSTRAP_HOST=127.0.0.1
REUS_BOOTSTRAP_PORT=9444
REUS_NODE_DATA_DIR=/var/lib/reus/node-1
# Use --seed-url only for a node that has already been approved by the cluster.
REUS_NODE_SEED_ARGS=

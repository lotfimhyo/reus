# Project: Reus
# Founder: Lotfi Mahiddine
# Organization: Reulink
# Contact: Contact@reulink.app
#
# انسخ هذا الملف إلى .env ثم ولّد القيم السرية قبل التشغيل.
# لا تضع .env الحقيقي في Git أو داخل صورة الحاوية.

REUS_API_KEY=generate-a-unique-admin-secret-at-least-24-chars
REUS_USER_API_KEY=generate-a-unique-user-secret-at-least-24-chars
REUS_CHAT_RATE_LIMIT_PER_MINUTE=30
REUS_ADMIN_RATE_LIMIT_PER_MINUTE=20
REUS_RATE_LIMITER_MAX_KEYS=10000
REUS_RATE_LIMITER_CLEANUP_INTERVAL_SECONDS=60
REUS_TRUST_PROXY_HEADERS=false
REUS_MAX_REQUEST_BODY_BYTES=1048576
REUS_SECURITY_HEADERS_ENABLED=true

REUS_AUTO_SEED_DEFAULT_AGENT=true
REUS_DEFAULT_AGENT_NAME=default-agent
REUS_ENVIRONMENT=development
REUS_LOG_LEVEL=INFO
REUS_STORAGE_BACKEND=memory
REUS_DATABASE_URL=postgresql+psycopg://reus_veritas:CHANGE_ME@localhost:5432/reus_veritas_os
REUS_EVENT_BUS_BACKEND=memory
REUS_REDIS_URL=redis://localhost:6379/0
REUS_WORKER_ENABLED=false
REUS_WORKER_POOL_SIZE=4
REUS_TASK_EXECUTOR=default
REUS_ANTHROPIC_API_KEY=
REUS_ENCRYPTION_KEY=
REUS_OPENAI_API_KEY=
REUS_GOOGLE_API_KEY=
REUS_TELEGRAM_ENABLED=false
REUS_TELEGRAM_BOT_TOKEN=
REUS_TELEGRAM_ALLOWED_CHAT_IDS=
REUS_TELEGRAM_POLL_TIMEOUT=25
REUS_TELEGRAM_APPROVAL_TTL_SECONDS=300
REUS_TELEGRAM_APPROVAL_STORE_PATH=data/telegram_approvals.json
REUS_TELEGRAM_APPROVAL_AUDIT_PATH=data/telegram_approval_audit.jsonl
# تفويض ربط لوحة التحكم يمر عبر /pair_control_plane ثم موافقة Telegram؛ لا
# تضع عنوان لوحة التحكم أو مفتاح المستخدم في رسالة Telegram.
REUS_CONTROL_PLANE_PAIRING_TTL_SECONDS=300
REUS_CONTROL_PLANE_PAIRING_STORE_PATH=data/control_plane_pairings.json
REUS_CONTROL_PLANE_PAIRING_AUDIT_PATH=data/control_plane_pairing_audit.jsonl
REUS_OLLAMA_ENABLED=false
REUS_OLLAMA_BASE_URL=http://localhost:11434
REUS_OLLAMA_MODEL=llama3.1
REUS_AUTONOMY_GOVERNANCE_STORE_PATH=data/autonomy_governance.json
REUS_AUTONOMY_GOVERNANCE_AUDIT_PATH=data/autonomy_governance_audit.jsonl
REUS_SECRETS_BACKEND=env
REUS_SECRETS_VAULT_ADDR=
REUS_SECRETS_VAULT_TOKEN=
REUS_SECRETS_VAULT_PATH=reus-veritas
REUS_SECRETS_AWS_REGION=us-east-1
REUS_SECRETS_AWS_SECRET_ID=reus-veritas/production
